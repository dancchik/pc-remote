# Copy this file to .env and fill in real values. Never commit .env.

# Secret token the phone must send in "Authorization: Bearer <token>".
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AGENT_TOKEN=change-me

# Address to listen on. 127.0.0.1 = this PC only (for testing).
# Later: the PC's Tailscale IP (100.x.y.z), so only your Tailscale devices can connect.
AGENT_HOST=127.0.0.1
AGENT_PORT=8765

# 1 = only log commands (lock, shutdown...) instead of executing them. For testing.
AGENT_DRY_RUN=0
